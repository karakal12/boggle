// PreviewType: size
uniform float2 size;
uniform mat4 translationMatrix;
uniform shader composable;

const float PI = 3.14159265359;
const float2 torusRadii = float2(2, 1);

float sdTorus(float3 p, float2 t) {
    float2 q = float2(length(p.xz)-t.x, p.y);
    return length(q) - t.y;
}

float map(float3 p) {
    return sdTorus(p, torusRadii);
}

float3 getNormal(float3 p) {
    float2 e = float2(0.001, 0);
    return normalize(float3(
        map(p + e.xyy) - map(p - e.xyy),
        map(p + e.yxy) - map(p - e.yxy),
        map(p + e.yyx) - map(p - e.yyx)
    ));
}

half4 main(float2 fragCoord) {
  float2 uv = (fragCoord - 0.5 * size.xy) / size.y;

  float3 camera = float3(0, 0, -8);
  float3 rayDir = normalize(float3(uv, 1));
  float3 lightPos = float3(-1, -1, -3);

  // --- transformations ---

  camera = (translationMatrix * float4(camera, 1.0)).xyz;
  rayDir = (translationMatrix * float4(rayDir, 0.0)).xyz;
  lightPos = (translationMatrix * float4(lightPos, 1.0)).xyz;

  // --- ray marching loop ---

  float distanceTraveled = 0;
  const int maxSteps = 100;
  const float surfaceThreshold = .001;
  const float maxDistance = 30;

  float3 currentPos;
  float currentDistance = 0;

  for (int i = 0; i < maxSteps; i++) {
      currentPos = camera + rayDir * distanceTraveled;
      currentDistance = map(currentPos);

      distanceTraveled += currentDistance;

      if (currentDistance < surfaceThreshold || distanceTraveled > maxDistance) break;
  }

  half4 color = half4(0, 0, 0, 0);

  if (distanceTraveled < maxDistance) {
      float3 normal = getNormal(currentPos);

      float uTex = atan(currentPos.z, currentPos.x) / (2 * PI) + 0.5;
      float2 q = float2(length(currentPos.xz) - torusRadii.x, currentPos.y);
      float vTex = atan(q.y, q.x) / (2 * PI) + 0.5;

      float2 texCoord = float2(uTex, vTex) * size;
      half4 texColor = composable.eval(texCoord);

      float3 lightDir = normalize(lightPos - currentPos);
      float diffused = clamp(dot(normal, lightDir), 0.2, 1);

      color = texColor * diffused;
      color.a = texColor.a;
  }

  return color;
}